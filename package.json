{
  "name": "dc-hospital",
  "version": "1.0.0",
  "description": "DC Hospital — full-stack Hospital Management System (React + Supabase)",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "sql:build": "tsx scripts/build-master-sql.ts",
    "preflight": "tsx scripts/preflight.ts",
    "test": "vitest run",
    "test:edge": "npx --yes deno@2 test --no-lock --no-config --allow-env --allow-read tests/edge/",
    "check": "tsc -b && eslint . && npm run sql:build && vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avinashtosoni/DC-hospital.git"
  },
  "bugs": {
    "url": "https://github.com/Avinashtosoni/DC-hospital/issues"
  },
  "homepage": "https://github.com/Avinashtosoni/DC-hospital#readme",
  "dependencies": {
    "@firebase/app": "^0.16.2",
    "@firebase/messaging": "^0.13.3",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "private": true,
  "type": "module"
}
