# Leave these empty to run in local DEMO mode (data persisted in your browser's localStorage).
# Fill them to use Supabase (run supabase/master.sql in the Supabase SQL editor first).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# true = never fall back to demo mode (recommended for every real hospital install)
VITE_REQUIRE_BACKEND=
# single (default) = one hospital per install · multi = many hospitals on one database, picked by domain
VITE_TENANCY=single
# production | staging
VITE_APP_ENV=production
# Multi-hospital mode: platform brand + its own domain (hospital websites use their custom domains)
VITE_PLATFORM_NAME=Hospital Comrade
VITE_PLATFORM_DOMAIN=hospital.digitalcomrade.in
